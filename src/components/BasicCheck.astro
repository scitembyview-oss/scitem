---
import type { Question } from '../data/checks';
import { SHEET_URL } from '../data/catalog';
export type { Question };

interface Props {
  id: string;
  title: string;
  questions: Question[];
  /** show √ π π² buttons under every number answer (on all of them, so the buttons don't hint which answers have a root) */
  symbols?: boolean;
}
// Answers are NOT here: they live encrypted in src/data/check-keys.json and are only opened on the teacher page.
const { id, title, questions, symbols = false } = Astro.props;
---
<section class="quiz" data-id={id} data-sheet={SHEET_URL}>
  <a class="crumb" href="/students/">← สำหรับนักเรียน · เช็คพื้นฐานก่อนเรียน</a>
  <h1>{title}</h1>
  <p class="lead">ทำก่อนเรียน เพื่อให้ครูรู้ว่าต้องทวนพื้นฐานตรงไหน ไม่มีผลกับคะแนน ตอบตามที่คิดได้เลย ทำไม่ได้ก็ข้ามได้</p>

  <form class="card" id="start">
    <label for="name">ชื่อเล่น</label>
    <div class="row">
      <input id="name" class="name" maxlength="30" autocomplete="off" required />
      <button type="submit">เริ่มทำ</button>
    </div>
    <p class="hint">มี {questions.length} ข้อ ทำทีละข้อ ตอบเป็นตัวเลขหรือเลือกตัวเลือก ไม่ต้องแสดงวิธีทำ ไม่ใช้เครื่องคิดเลข ระบบจับเวลาแต่ละข้อ</p>
    {symbols && <p class="hint">ถ้าคำตอบติดรูทหรือ π ไม่ต้องแปลงเป็นทศนิยม กดปุ่ม √ π π² ใต้ช่องคำตอบ เช่น 2√10 หรือ 20π²</p>}
  </form>

  <form id="qs" hidden>
    <div class="progress"><div class="bar" id="bar"></div></div>
    {questions.map((q, qi) => (
      <fieldset class="card q" data-kind={q.kind} hidden>
        <legend><span class="num">ข้อ {qi + 1}/{questions.length}</span> <span class="lab">{q.label}</span></legend>
        <p class="qt" set:html={q.text} />
        {q.kind === 'num' ? (
          <div class="parts">
            {q.parts!.map((p, pi) => (
              <>
                {pi > 0 && q.joiner && <span class="joiner" set:html={q.joiner} />}
                <label class="part">
                  {p.label && <span class="plabel" set:html={p.label} />}
                  <input inputmode="decimal" autocomplete="off" maxlength="20" aria-label={`ข้อ ${qi + 1} ช่องที่ ${pi + 1}`} />
                  {p.unit && <span class="unit" set:html={p.unit} />}
                </label>
              </>
            ))}
            {symbols && (
              <div class="pad" aria-label="ปุ่มสัญลักษณ์">
                <button type="button" data-ins="√">√</button>
                <button type="button" data-ins="π">π</button>
                <button type="button" data-ins="π²">π²</button>
                <button type="button" data-del>⌫</button>
              </div>
            )}
          </div>
        ) : (
          <div class="opts">
            {q.options!.map((o, oi) => (
              <label class="opt"><input type="radio" name={`q${qi}`} value={oi} /> <span><b>{'กขคง'[oi]}.</b> <Fragment set:html={o} /></span></label>
            ))}
          </div>
        )}
      </fieldset>
    ))}
    <div class="nav">
      <button type="button" class="ghost" id="prev">ย้อนกลับ</button>
      <button type="button" id="next">ข้อถัดไป</button>
    </div>
  </form>

  <article class="card result" id="result" hidden>
    <h2>ทำเสร็จแล้ว 🎉</h2>
    <p class="status" id="status"></p>
    <button type="button" id="retry" hidden>ลองส่งอีกครั้ง</button>
    <div id="backup" hidden>
      <p>หรือส่งรหัสนี้ให้ครูทาง LINE ครูจะเป็นคนเปิดดูคะแนนและเฉลย</p>
      <pre id="code"></pre>
      <div class="row">
        <a class="btn line" id="line" target="_blank" rel="noopener">ส่งทาง LINE</a>
        <button type="button" id="copy" class="ghost">คัดลอกรหัส</button>
      </div>
      <p class="hint">ถ้าปุ่มไม่ทำงาน ให้กดค้างที่รหัสแล้วคัดลอกเอง ส่งให้ครูทั้งก้อน</p>
    </div>
  </article>
</section>

<script>
  import { encodeCheck } from '../lib/check-code.js';

  const root = document.querySelector<HTMLElement>('.quiz')!;
  const id = root.dataset.id!;
  const start = document.getElementById('start') as HTMLFormElement;
  const qs = document.getElementById('qs') as HTMLFormElement;
  const sets = [...qs.querySelectorAll<HTMLFieldSetElement>('fieldset.q')];
  const prev = document.getElementById('prev') as HTMLButtonElement;
  const next = document.getElementById('next') as HTMLButtonElement;
  const bar = document.getElementById('bar')!;
  const ms = sets.map(() => 0);
  let cur = 0;
  let since = 0;
  let name = '';

  function show(i: number) {
    if (since) ms[cur] += Date.now() - since;
    cur = i;
    since = Date.now();
    sets.forEach((f, k) => (f.hidden = k !== i));
    prev.style.visibility = i === 0 ? 'hidden' : 'visible';
    next.textContent = i === sets.length - 1 ? 'ส่งคำตอบ' : 'ข้อถัดไป';
    bar.style.width = `${(100 * i) / sets.length}%`;
    sets[i].querySelector<HTMLInputElement>('input:not([type=radio])')?.focus();
  }

  function answerOf(f: HTMLFieldSetElement) {
    if (f.dataset.kind === 'mc') return f.querySelector<HTMLInputElement>('input:checked')?.value ?? '';
    return [...f.querySelectorAll<HTMLInputElement>('input')].map((i) => i.value.trim().slice(0, 20)).join('|');
  }

  function finish() {
    ms[cur] += Date.now() - since;
    const blanks = sets.filter((f) => !answerOf(f).replace(/\|/g, '')).length;
    if (blanks && !confirm(`ยังไม่ได้ตอบ ${blanks} ข้อ ส่งเลยไหม`)) {
      since = Date.now();
      return;
    }
    qs.hidden = true;
    const answers = sets.map(answerOf);
    const secs = ms.map((m) => Math.round(m / 1000));
    const code = encodeCheck([1, id, name, answers, secs, Math.round(Date.now() / 60000)]);
    document.getElementById('code')!.textContent = code;
    (document.getElementById('line') as HTMLAnchorElement).href =
      'https://line.me/R/share?text=' + encodeURIComponent(`รหัสเช็คพื้นฐานของ ${name}\n${code}`);
    const copy = document.getElementById('copy') as HTMLButtonElement;
    copy.onclick = async () => {
      try {
        await navigator.clipboard.writeText(code);
        copy.textContent = 'คัดลอกแล้ว';
      } catch {
        copy.textContent = 'คัดลอกไม่ได้ กดค้างที่รหัสแทน';
      }
    };
    const res = document.getElementById('result')!;
    res.hidden = false;
    res.scrollIntoView({ behavior: 'smooth', block: 'start' });
    // Send straight to the teacher's Google Sheet; the LINE code is only the backup if that fails.
    const sid = Math.random().toString(36).slice(2, 10); // lets the sheet drop a resend of the same result
    const status = document.getElementById('status')!;
    const retry = document.getElementById('retry') as HTMLButtonElement;
    const backup = document.getElementById('backup')!;
    const url = root.dataset.sheet;
    if (!url) {
      status.textContent = 'ส่งรหัสด้านล่างให้ครู';
      backup.hidden = false;
      return;
    }
    const send = async () => {
      retry.hidden = true;
      status.dataset.s = 'wait';
      status.textContent = '⏳ กำลังส่งผลให้ครู… อย่าเพิ่งปิดหน้านี้หรือกดอะไรนะ';
      try {
        const r = await fetch(url, { method: 'POST', body: JSON.stringify({ action: 'submit', id: sid, quiz: id, name, answers, secs }) });
        if (!(await r.json()).ok) throw new Error();
        status.dataset.s = 'ok';
        status.textContent = 'ส่งคำตอบให้ครูแล้ว ✓ ปิดหน้านี้ได้เลย';
        backup.hidden = true;
      } catch {
        status.dataset.s = 'fail';
        status.textContent = 'ส่งไม่สำเร็จ เช็คอินเทอร์เน็ตแล้วกดลองส่งอีกครั้ง';
        retry.hidden = false;
        backup.hidden = false;
      }
    };
    retry.onclick = send;
    send();
  }

  start.addEventListener('submit', (e) => {
    e.preventDefault();
    name = (document.getElementById('name') as HTMLInputElement).value.trim();
    if (!name) return;
    start.hidden = true;
    qs.hidden = false;
    show(0);
  });
  // Symbol buttons type into the answer box the student last touched (default: the first box of that question).
  let lastBox: HTMLInputElement | null = null;
  qs.addEventListener('focusin', (e) => {
    if (e.target instanceof HTMLInputElement && e.target.type !== 'radio') lastBox = e.target;
  });
  qs.querySelectorAll<HTMLButtonElement>('.pad button').forEach((b) => {
    b.addEventListener('pointerdown', (e) => e.preventDefault()); // keep the keyboard open and the caret in place
    b.addEventListener('click', () => {
      const f = b.closest('fieldset')!;
      const box = lastBox && f.contains(lastBox) ? lastBox : f.querySelector<HTMLInputElement>('input')!;
      const at = box.selectionStart ?? box.value.length;
      const end = box.selectionEnd ?? at;
      if (b.dataset.del !== undefined) {
        const from = at === end ? Math.max(0, at - 1) : at;
        box.setRangeText('', from, end, 'end');
      } else if (box.value.length + b.dataset.ins!.length <= 20) {
        box.setRangeText(b.dataset.ins!, at, end, 'end');
      }
      box.focus();
    });
  });

  prev.addEventListener('click', () => cur > 0 && show(cur - 1));
  next.addEventListener('click', () => (cur < sets.length - 1 ? show(cur + 1) : finish()));
  qs.addEventListener('submit', (e) => {
    e.preventDefault();
    next.click();
  });
</script>

<style>
  .quiz { max-width: 640px; margin: 0 auto; padding: 32px 0 16px; }
  .crumb { display: inline-block; color: var(--muted); font-weight: 600; text-decoration: none; padding: 6px 0; }
  .crumb:hover { color: var(--ink); }
  h1 { font-size: clamp(1.8rem, 6vw, 2.4rem); line-height: 1.2; margin: 4px 0 12px; }
  .lead { color: var(--muted); margin: 0 0 24px; }
  .card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); padding: 20px; margin: 0 0 18px; }
  fieldset.card { min-width: 0; }
  legend { padding: 0 6px; }
  .num { background: var(--blue); color: #fff; font-weight: 700; border-radius: 8px; padding: 2px 10px; }
  .lab { color: var(--muted); font-size: 0.9rem; margin-left: 4px; }
  .qt { margin: 0 0 14px; font-size: 1.1rem; }
  label { font-weight: 600; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  input:not([type='radio']) {
    font: inherit; font-size: 1.1rem; padding: 10px 12px; border: 2px solid var(--border); border-radius: 6px;
    background: var(--surface); color: var(--text); min-width: 0;
  }
  input:focus { outline: none; border-color: var(--brand); }
  .name { flex: 1 1 200px; }
  .parts { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; }
  .part { display: flex; align-items: center; gap: 8px; }
  .part input { width: 7.5em; }
  .plabel, .unit { color: var(--muted); font-weight: 600; }
  .joiner { font-size: 1.3rem; }
  .pad { flex-basis: 100%; display: flex; gap: 8px; }
  .pad button { flex: 1; max-width: 5em; padding: 10px 0; font-size: 1.15rem; background: var(--brand-soft); color: var(--brand); border: 2px solid var(--brand); }
  .opts { display: grid; gap: 8px; }
  .opt { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; cursor: pointer; }
  .opt:has(input:checked) { border-color: var(--brand); background: var(--brand-soft); }
  .opt input { margin-top: 0.45em; accent-color: var(--brand); }
  button, .btn {
    font: inherit; font-weight: 700; min-height: 44px; padding: 10px 22px; border: 1px solid var(--rule); border-radius: var(--radius);
    background: var(--ink); color: #fff; cursor: pointer; text-decoration: none; display: inline-block;
  }
  .ghost { background: transparent; color: var(--brand); border: 2px solid var(--brand); }
  .line { background: var(--line); color: #fff; }
  .nav { display: flex; justify-content: space-between; gap: 10px; }
  .nav #next { flex: 1; max-width: 60%; margin-left: auto; }
  .progress { height: 6px; background: var(--border); border-radius: 99px; margin: 0 0 14px; overflow: hidden; }
  .bar { height: 100%; width: 0; background: var(--brand); transition: width 0.2s; }
  .hint { color: var(--muted); font-size: 0.92rem; margin: 10px 0 0; }
  .result h2 { margin: 0 0 6px; color: var(--brand); }
  .status { font-weight: 700; font-size: 1.1rem; }
  .status[data-s] { font-size: 1.25rem; padding: 16px 18px; border-radius: 12px; border: 3px solid; }
  .status[data-s='wait'] { background: #fff4d6; border-color: #e0a100; color: #7a4d00; animation: blink 1.2s ease-in-out infinite; }
  .status[data-s='ok'] { background: #e7f8ef; border-color: #16a34a; color: #15803d; }
  .status[data-s='fail'] { background: #fdecea; border-color: #a6402a; color: #a6402a; }
  @keyframes blink { 50% { opacity: 0.6; } }
  @media (prefers-reduced-motion: reduce) { .status[data-s='wait'] { animation: none; } }
  #retry { margin-bottom: 14px; }
  pre { white-space: pre-wrap; word-break: break-all; background: var(--bg); border: 2px dashed var(--brand); border-radius: 10px; padding: 12px; font: 600 0.95rem ui-monospace, Menlo, monospace; user-select: all; }
</style>
