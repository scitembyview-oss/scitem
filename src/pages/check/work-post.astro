---
import Base from '../../layouts/Base.astro';
import BasicCheck from '../../components/BasicCheck.astro';
import { checks } from '../../data/checks';

// Questions: src/data/checks.ts · answer key + solutions: encrypted in src/data/check-keys.json under "work-post".
const { title, questions } = checks['work-post'];
---
<Base title="Work and Power Post-test · scitem" description="Work and Power Post-test, 10 questions" noindex>
  <BasicCheck id="work-post" title={title} questions={questions} lead="Do this after the lessons. It is the same kind of test as the pre-test, with new numbers. Answer what you can, and skip any question you cannot do." />
</Base>
