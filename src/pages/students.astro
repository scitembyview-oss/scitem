---
import Base from '../layouts/Base.astro';
import { items } from '../data/catalog';

const checks = items.filter((it) => it.kind === 'check');
---
<Base title="นักเรียน · scitem" description="เช็คพื้นฐานก่อนเรียน และ Answer Vault สำหรับนักเรียน scitem">
  <header class="page-head">
    <h1>สำหรับนักเรียน</h1>
    <p>ทำเช็คพื้นฐานก่อนเรียนเพื่อให้ครูรู้ว่าต้องทวนตรงไหน ไม่มีผลกับคะแนน ทำเสร็จแล้วกดส่งรหัสให้ครูทาง LINE</p>
  </header>

  <section>
    <h2>เช็คพื้นฐานก่อนเรียน</h2>
    <ul class="checks">
      {checks.map((it) => (
        <li>
          <a href={it.href}>
            <b>{it.title}</b>
            <span>{it.grade} · {it.meta} · {it.note}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </li>
      ))}
    </ul>
    <ol class="steps">
      <li><b>เลือกเรื่องที่ครูบอก</b> ใส่ชื่อเล่นแล้วเริ่มทำ</li>
      <li><b>ตอบทีละข้อ</b> ไม่ต้องแสดงวิธีทำ ทำไม่ได้ก็ข้ามได้</li>
      <li><b>ส่งรหัสให้ครู</b> กดปุ่มส่งทาง LINE ตอนจบ</li>
    </ol>
  </section>

  <section class="vault">
    <h2>ทำชีทครบแล้ว? เปิดเฉลยที่ Answer Vault</h2>
    <p>วงตัวอักษรใน Code Breaker ท้ายชีทให้ครบ อ่านเรียงจากข้อแรกถึงข้อสุดท้าย แล้วใส่เป็นรหัสเพื่อเปิดเฉลยมาตรวจเอง</p>
    <a class="btn" href="/vault/">เปิด Answer Vault</a>
  </section>
</Base>

<style>
  h2 { font-size: 1.4rem; margin: 0 0 14px; }
  .checks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; max-width: 720px; }
  .checks a {
    display: grid; grid-template-columns: 1fr auto; gap: 0 12px; align-items: center;
    padding: 16px 20px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--paper);
    color: var(--ink); text-decoration: none; transition: border-color 0.2s, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .checks a:hover { border-color: var(--blue); transform: translateX(3px); }
  .checks b { font-size: 1.1rem; }
  .checks span { grid-row: 2; color: var(--muted); font-size: 0.92rem; }
  .checks svg { grid-row: 1 / 3; grid-column: 2; width: 24px; height: 24px; color: var(--blue); }
  .steps { margin: 20px 0 0; padding-left: 1.3em; color: var(--muted); max-width: 720px; }
  .steps b { color: var(--ink); }
  .vault { margin-top: 56px; padding-top: 32px !important; padding-bottom: 32px !important; background: var(--tint); border-radius: var(--radius); max-width: 1120px !important; }
  .vault p { margin: 0 0 18px; color: var(--muted); max-width: 62ch; }
</style>
