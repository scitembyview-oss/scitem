---
import { families, type Family } from '../data/catalog';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** colours the page in one family's palette and marks it current in the menu */
  family?: Family;
}
const { title, description, noindex = false, family } = Astro.props;
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'scitem',
  url: 'https://scitem.net',
  description: 'ชีทวิทยาศาสตร์สองภาษา ไทย-อังกฤษ สำหรับนักเรียน EP และ International ป.5 ถึง ม.3',
  email: 'view@scitem.net',
  sameAs: ['https://lin.ee/NO52k1Y'],
});
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = Object.entries(families) as [Family, (typeof families)[Family]][];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#e9edf1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:site_name" content="scitem" />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={orgJsonLd} />
    <link rel="preload" href="/fonts/anuphan-thai.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-f={family}>
    <header class="site-header">
      <a href="/" class="logo" aria-label="scitem หน้าแรก">
        <span class="logo-tile"><small>21</small>Sc</span><span class="logo-rest">item</span>
      </a>
      <nav aria-label="เมนูหลัก">
        {nav.map(([f, v]) => (
          <a href={v.href} data-f={f} aria-current={f === family ? 'page' : undefined}>
            <i aria-hidden="true"></i>{v.th}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>scitem · ชีทวิทย์สองภาษา สำหรับเด็ก EP/Inter · สอนโดยครูวิว</p>
      <p><a href="https://lin.ee/NO52k1Y" target="_blank" rel="noopener">LINE scitem</a> · <a href="mailto:view@scitem.net">view@scitem.net</a></p>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Anuphan';
    font-weight: 100 700;
    font-display: swap;
    src: url(/fonts/anuphan-thai.woff2) format('woff2');
    unicode-range: U+02D7, U+0303, U+0331, U+0E01-0E5B, U+200C-200D, U+25CC;
  }
  @font-face {
    font-family: 'Anuphan';
    font-weight: 100 700;
    font-display: swap;
    src: url(/fonts/anuphan-latin.woff2) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  :root {
    --ground: #e9edf1;
    --surface: #ffffff;
    --ink: #161b26;
    --muted: #4f5a6b;
    --rule-soft: #a9b2bf;
    /* old names, still used by the check and vault pages */
    --bg: var(--ground);
    --text: var(--ink);
    --border: #cfd6df;
    --brand: var(--f-deep, var(--ink));
    --brand-soft: var(--f-soft, #dfe5ec);
    --accent: #ffc93c;
  }
  [data-f='lessons'] { --f-fill: #2c6be0; --f-ink: #ffffff; --f-deep: #1f54b8; --f-soft: #dce7fb; }
  [data-f='students'] { --f-fill: #ffc93c; --f-ink: #1d1a12; --f-deep: #8a5a00; --f-soft: #fff1c7; }
  [data-f='parents'] { --f-fill: #ff7657; --f-ink: #1d1210; --f-deep: #b23d22; --f-soft: #ffe1d9; }
  [data-f='teacher'] { --f-fill: #5b3fa8; --f-ink: #ffffff; --f-deep: #4a3190; --f-soft: #e7e0f6; }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--ground);
    color: var(--ink);
    font-family: 'Anuphan', 'Noto Sans Thai', system-ui, sans-serif;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--f-fill, #ffc93c); color: var(--f-ink, var(--ink)); }
  a { color: var(--brand); text-underline-offset: 0.18em; text-decoration-thickness: 1.5px; }
  :focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; }
  input, textarea { caret-color: var(--brand); accent-color: var(--brand); }
  h1, h2, h3 { line-height: 1.25; text-wrap: balance; letter-spacing: -0.01em; }
  main { max-width: 1160px; margin: 0 auto; padding: 0 16px; }

  .site-header {
    max-width: 1160px;
    margin: 0 auto;
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    flex-wrap: wrap;
  }
  .logo { display: flex; align-items: center; gap: 6px; text-decoration: none; color: var(--ink); font-weight: 700; font-size: 1.45rem; letter-spacing: -0.02em; }
  .logo-tile {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.1em;
    height: 2.1em;
    padding-top: 0.25em;
    border: 2px solid var(--ink);
    border-radius: 5px;
    background: var(--surface);
    font-size: 0.82em;
  }
  .logo-tile small { position: absolute; top: 2px; left: 4px; font-size: 0.42em; font-weight: 600; line-height: 1; }
  .site-header nav { display: flex; gap: 6px; flex-wrap: wrap; }
  .site-header nav a {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 12px;
    min-height: 44px;
    border-radius: 6px;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .site-header nav i { width: 12px; height: 12px; border: 1.5px solid var(--ink); border-radius: 2px; background: var(--f-fill); }
  .site-header nav a:hover { background: var(--surface); }
  .site-header nav a[aria-current='page'] { background: var(--f-fill); color: var(--f-ink); box-shadow: inset 0 0 0 2px var(--ink); }
  .site-header nav a[aria-current='page'] i { border-color: currentColor; }

  .site-footer { max-width: 1160px; margin: 64px auto 0; padding: 24px 16px 40px; border-top: 2px solid var(--ink); color: var(--muted); font-size: 0.9rem; display: flex; justify-content: space-between; gap: 8px 24px; flex-wrap: wrap; }
  .site-footer p { margin: 0; }
  .site-footer a { color: var(--ink); font-weight: 600; }

  /* shared page head for the family pages */
  .fam-head { display: grid; grid-template-columns: auto 1fr; gap: 24px; align-items: end; padding: 28px 0 32px; }
  .fam-head h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 0; }
  .fam-head p { margin: 8px 0 0; color: var(--muted); max-width: 60ch; font-size: 1.05rem; }
  .fam-sym {
    display: flex; flex-direction: column; justify-content: space-between;
    width: clamp(92px, 14vw, 132px); aspect-ratio: 1 / 1.08; padding: 8px 10px;
    border: 2px solid var(--ink); border-radius: 6px; background: var(--f-fill); color: var(--f-ink);
    font-weight: 700; line-height: 1;
  }
  .fam-sym span { font-size: clamp(2.4rem, 6vw, 3.4rem); letter-spacing: -0.03em; }
  .fam-sym small { font-size: 0.8rem; font-weight: 600; }
  @media (max-width: 560px) { .fam-head { grid-template-columns: 1fr; gap: 16px; } }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 48px;
    padding: 10px 22px; border: 2px solid var(--ink); border-radius: 6px;
    background: var(--ink); color: #fff; font: inherit; font-weight: 700; text-decoration: none; cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn:hover { transform: translateY(-2px); }
  .btn.line { background: #06c755; color: #08240f; }
  .muted { color: var(--muted); }
</style>
