---
// One page viewer shared by every <Pages /> stack on the page.
import { LINE_URL } from '../data/catalog';
---
<dialog id="viewer" aria-label="ตัวอย่าง">
  <header>
    <b id="viewer-title"></b>
    <a class="btn line small" href={LINE_URL} target="_blank" rel="noopener">ขอชีทเต็มทางไลน์</a>
    <button type="button" class="close" aria-label="ปิด"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" /></svg></button>
  </header>
  <div id="viewer-pages"></div>
</dialog>

<script>
  const dlg = document.getElementById('viewer') as HTMLDialogElement;
  const box = document.getElementById('viewer-pages')!;
  document.querySelectorAll<HTMLButtonElement>('[data-pages]').forEach((b) =>
    b.addEventListener('click', () => {
      const pages: string[] = JSON.parse(b.dataset.pages!);
      document.getElementById('viewer-title')!.textContent = b.dataset.title!;
      box.innerHTML = pages.map((src, i) => `<img src="${src}" alt="หน้า ${i + 1}" />`).join('');
      box.scrollTop = 0;
      dlg.showModal();
    }),
  );
  dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  dialog { width: min(920px, 100vw - 24px); max-height: calc(100dvh - 24px); padding: 0; border: 0; border-radius: var(--radius); background: var(--tint); color: var(--ink); overflow: hidden; }
  dialog[open] { display: flex; flex-direction: column; }
  dialog::backdrop { background: rgb(20 33 61 / 0.6); }
  header { display: flex; align-items: center; gap: 12px; padding: 10px 12px 10px 20px; background: var(--paper); border-bottom: 1px solid var(--rule); }
  header b { margin-right: auto; }
  .close { display: grid; place-items: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: var(--tint); cursor: pointer; color: var(--ink); }
  #viewer-pages { overflow-y: auto; padding: 16px; display: grid; gap: 16px; }
  #viewer-pages :global(img) { width: 100%; border-radius: 6px; box-shadow: 0 4px 16px -8px rgb(20 33 61 / 0.4); background: #fff; }
</style>
