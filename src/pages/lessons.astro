---
import Base from '../layouts/Base.astro';
import Pages from '../components/Pages.astro';
import Viewer from '../components/Viewer.astro';
import { courses, items, kinds, type CourseId } from '../data/catalog';

const rows = (Object.entries(courses) as [CourseId, (typeof courses)[CourseId]][]).map(([id, c]) => ({
  ...c,
  items: items.filter((it) => it.course === id),
}));
---
<Base title="บทเรียน · scitem" description="สไลด์และเช็คที่ใช้สอน แยกตามคอร์ส: Light Explorer (EP Primary 5 · St. Gabriel) และฟิสิกส์ ม.ต้น">
  <header class="page-head">
    <h1>บทเรียน</h1>
    <p>แยกตามคอร์ส สไลด์ใช้บน iPad แตะรูปให้ขยับได้และมีปากกาเขียน ส่วนเช็คพื้นฐานส่งให้นักเรียนทำก่อนเรียน</p>
  </header>

  {rows.map((c) => (
    <section class="course">
      <div class="label">
        <p class="where">{c.where}</p>
        <h2>{c.name}</h2>
        <p class="muted">{c.blurb}</p>
      </div>
      <div class="list">
        {c.items.map((it) => (
          <article class:list={['item', it.kind]}>
            {it.pages && <Pages pages={it.pages} title={it.title} shape="slide" />}
            <div>
              <p class="kind">{kinds[it.kind]} · {it.grade} · {it.meta}</p>
              <h3><a href={it.href}>{it.title}</a></h3>
              <p class="muted">{it.th}{it.note && ` · ${it.note}`}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
  <Viewer />
</Base>

<style>
  .course { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); overflow-x: clip; gap: 32px; padding-top: 32px; padding-bottom: 40px; border-top: 1px solid var(--rule); }
  .where { margin: 0; color: var(--blue); font-weight: 700; font-size: 0.92rem; }
  h2 { margin: 2px 0 8px; font-size: 1.6rem; }
  .label .muted { margin: 0; }
  .list { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
  .item { display: grid; gap: 12px; align-content: start; }
  .item.check { padding: 18px 20px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--tint); }
  .kind { margin: 0; font-size: 0.85rem; font-weight: 600; color: var(--muted); }
  h3 { margin: 0; font-size: 1.15rem; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--blue); text-decoration: underline; }
  .item .muted { margin: 2px 0 0; font-size: 0.93rem; }
  @media (max-width: 820px) { .course { grid-template-columns: minmax(0, 1fr); gap: 20px; } }
</style>
