---
import { existsSync } from 'node:fs';
import Base from '../layouts/Base.astro';
import { courses, items, kinds, LINE_URL, type CourseId } from '../data/catalog';

// any of these names works, so a photo uploaded straight from a phone shows up without renaming the type
const photo = ['วิวถือไมค์.jpeg', 'teacher.jpg', 'teacher.jpeg', 'teacher.png', 'teacher.webp', 'teacher.JPG', 'teacher.PNG'].find((f) => existsSync(`public/img/${f}`));
const courseList = (Object.entries(courses) as [CourseId, (typeof courses)[CourseId]][]).map(([id, c]) => ({
  id, ...c, items: items.filter((it) => it.course === id),
}));
---
<Base
  title="scitem · เรียนวิทย์สองภาษากับครูวิว สำหรับเด็ก EP/Inter"
  description="ครูวิวสอนวิทยาศาสตร์สองภาษาไทย-อังกฤษ สำหรับนักเรียน EP, International และ Gifted ป.5 ถึง ม.3 เรียนบนกระดาษ iPad หรือคอมก็ได้ ด้วยสไลด์ที่แตะแล้วขยับได้"
>
  <section class="hero full">
    <div class="wrap hero-in">
      <div class="copy">
        <h1>
          ห้องเรียน Science<br />
          ที่ลูกได้<span class="mark">แตะ</span> ได้<span class="mark">ลอง</span><br />แล้ว<span class="mark">เข้าใจ</span>จริง
        </h1>
        <p class="lead">
          ครูวิวสอนวิทย์สองภาษา ป.5–ม.3 ได้ทั้งเด็ก EP, Inter และ Gifted
          เรียนบนกระดาษ บน iPad หรือในคอมก็ได้ ด้วยสไลด์ที่แตะแล้วขยับได้
        </p>
        <div class="cta">
          <a class="btn line" href={LINE_URL} target="_blank" rel="noopener">ทักไลน์คุยกับครูวิว</a>
          <a class="btn ghost" href="#courses">ดูบทเรียน</a>
        </div>
      </div>

      <figure class="ipad">
        <div class="screen" id="live">
          <img src="/img/slides/light-5.jpg" alt="สไลด์ Light Explorer ฉายไฟฉายให้เกิดเงา" width="1194" height="834" fetchpriority="high" />
          <button type="button" id="try" class="try">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
            ลองแตะสไลด์จริง
          </button>
        </div>
        <figcaption><span class="hand">สไลด์ที่ใช้สอนจริง ลองแตะที่หิ่งห้อย หรือโคมไฟดู</span></figcaption>
      </figure>
    </div>
  </section>

  <section class="courses" id="courses">
    <div class="sec-head">
      <h2>เรียนอะไรกับครูวิว</h2>
      <a href="/lessons/">ดูบทเรียนทั้งหมด →</a>
    </div>
    <div class="course-grid">
      {courseList.map((c) => (
        <article class="course">
          <img src={c.cover} alt="" loading="lazy" width="1194" height="834" />
          <div class="course-body">
            <p class="where">{c.where}</p>
            <h3>{c.name} <span>{c.th}</span></h3>
            <p>{c.blurb}</p>
            <ul>
              {c.items.map((it) => (
                <li><a href={it.href}>{it.title}</a> <small>{kinds[it.kind]} · {it.meta}</small></li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="teacher" id="teacher">
    {photo && <img class="photo" src={`/img/${photo}`} alt="ครูวิว" width="549" height="611" loading="lazy" />}
    <div>
      <h2>สวัสดีค่ะ ครูวิวเอง</h2>
      <p>
        ครูวิวจบจากโรงเรียนมหิดลวิทยานุสรณ์ และวิศวกรรมศาสตร์ จุฬาลงกรณ์มหาวิทยาลัย (เกียรตินิยม)
        ติววิทยาศาสตร์มา 5 ปี มีลูกศิษย์สอบติดเตรียมอุดมศึกษา และ พสวท. บดินทรเดชา
      </p>
      <p>
        เด็ก EP เรียนวิทย์เป็นภาษาอังกฤษ บางคนเข้าใจเนื้อหาแต่ติดศัพท์ บางคนท่องศัพท์ได้แต่ไม่เข้าใจจริง
        ครูเลยสอนทั้งสองภาษาควบคู่กัน ได้ทั้งนักเรียน EP, International และห้องเรียนพิเศษ (Gifted)
      </p>
      <a class="btn line" href={LINE_URL} target="_blank" rel="noopener">ทักไลน์คุยกับครูวิว</a>
    </div>
  </section>

  <section class="start full">
    <div class="wrap start-in">
      <h2>เริ่มยังไง</h2>
      <p>ทักไลน์มาคุยกับครูวิวได้เลย บอกชั้นและโรงเรียนของลูก</p>
      <a class="btn line big" href={LINE_URL} target="_blank" rel="noopener">ทักไลน์ scitem</a>
    </div>
  </section>

</Base>

<script>
  // Swap the poster for the live slide deck only when asked, so the page stays light and scrolls freely on phones.
  const live = document.getElementById('live')!;
  document.getElementById('try')!.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = '/light-p5/?tap#p5';
    f.title = 'สไลด์ Light Explorer';
    live.replaceChildren(f);
    const fit = () => f.style.setProperty('--s', String(live.clientWidth / 1194));
    fit();
    new ResizeObserver(fit).observe(live);
  });
</script>

<style>
  .full { max-width: none !important; padding-left: 0 !important; padding-right: 0 !important; }
  .hero {
    background-color: var(--tint);
    background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 28px 28px;
    border-bottom: 1px solid var(--rule);
  }
  .hero-in { display: grid; grid-template-columns: 1fr 1.15fr; gap: 40px; align-items: center; padding-top: 56px; padding-bottom: 64px; }
  h1 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.35; margin: 0 0 18px; letter-spacing: -0.02em; }
  .lead { font-size: 1.12rem; color: var(--muted); margin: 0 0 28px; max-width: 46ch; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .ipad { margin: 0; }
  .screen {
    position: relative; aspect-ratio: 1194 / 834; overflow: hidden;
    border: 14px solid #1c2230; border-radius: 30px; background: #1c2230;
    box-shadow: 0 30px 60px -30px rgb(20 33 61 / 0.55), 0 0 0 1px #3a4255 inset;
  }
  .screen img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
  .screen :global(iframe) { position: absolute; top: 0; left: 0; width: 1194px; height: 834px; border: 0; transform: scale(var(--s, 0.5)); transform-origin: 0 0; background: #fff; }
  .try {
    position: absolute; left: 50%; top: 50%; translate: -50% -50%;
    display: flex; align-items: center; gap: 8px; min-height: 52px; padding: 10px 22px 10px 16px;
    border: 0; border-radius: 999px; background: var(--ink); color: #fff; font: inherit; font-weight: 700; cursor: pointer;
    box-shadow: 0 10px 24px -10px rgb(0 0 0 / 0.6);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .try:hover { transform: scale(1.05); }
  .try svg { width: 24px; height: 24px; }
  figcaption { margin: 14px 0 0 18px; }
  .hand { display: inline-block; font-weight: 600; color: var(--blue); rotate: -2deg; }
  .hand::before { content: ''; display: inline-block; width: 26px; height: 2px; margin: 0 8px 0.3em 0; background: currentColor; vertical-align: middle; }

  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 6px 20px; flex-wrap: wrap; margin-bottom: 24px; }
  .sec-head h2 { margin: 0; font-size: clamp(1.6rem, 3.4vw, 2.2rem); }
  .sec-head p { margin: 0; }
  .sec-head a { font-weight: 700; text-decoration: none; }

  .courses { padding-top: 72px; padding-bottom: 72px; }
  .course-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .course { border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; background: var(--paper); }
  .course > img { width: 100%; aspect-ratio: 16 / 8; object-fit: cover; object-position: top; border-bottom: 1px solid var(--rule); }
  .course-body { padding: 20px 24px 24px; }
  .where { margin: 0; color: var(--blue); font-weight: 700; font-size: 0.92rem; }
  .course h3 { margin: 2px 0 8px; font-size: 1.4rem; }
  .course h3 span { color: var(--muted); font-weight: 400; font-size: 1rem; }
  .course p { margin: 0 0 14px; }
  .course ul { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .course li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  .course li a { font-weight: 600; text-decoration: none; }
  .course li small { color: var(--muted); white-space: nowrap; }

  .teacher { display: flex; gap: 48px; align-items: center; padding-top: 88px; padding-bottom: 40px; }
  .teacher .photo { width: min(340px, 40%); aspect-ratio: 15 / 16; object-fit: cover; border-radius: 24px; rotate: -2deg; box-shadow: 0 24px 48px -24px rgb(20 33 61 / 0.5); }
  .teacher h2 { margin: 0 0 12px; font-size: clamp(1.6rem, 3.4vw, 2.2rem); }
  .teacher p { margin: 0 0 14px; max-width: 60ch; }
  .teacher .btn { margin-top: 8px; }

  .start { margin-top: 48px; background: var(--blue); color: #fff; }
  .start-in { display: grid; grid-template-columns: auto 1fr auto; gap: 24px 40px; align-items: center; padding-top: 48px; padding-bottom: 48px; }
  .start h2 { margin: 0; font-size: clamp(1.6rem, 3.4vw, 2.2rem); }
  .start p { margin: 0; color: #dbe5ff; font-size: 1.05rem; }
  .btn.big { min-height: 56px; padding: 12px 32px; font-size: 1.1rem; }

  @media (max-width: 960px) {
    .hero-in { grid-template-columns: 1fr; padding-top: 36px; gap: 32px; }
    .start-in { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .course-grid { grid-template-columns: 1fr; }
    .teacher { flex-direction: column; align-items: flex-start; gap: 28px; }
    .teacher .photo { width: 72%; }
    .screen { border-width: 9px; border-radius: 20px; }
  }
</style>
