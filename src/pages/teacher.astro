---
import Base from '../layouts/Base.astro';
import { items, kinds } from '../data/catalog';
const share = items.filter((it) => it.href && it.kind !== 'tool');
---
<Base title="ครู · scitem" description="หน้าครู ตรวจรหัสเช็คพื้นฐาน" noindex>
  <section class="t">
    <header class="head">
      <h1>หน้าครู</h1>
      <p>ใส่รหัสผ่านเพื่อตรวจรหัสเช็คของนักเรียน และคัดลอกลิงก์ส่งให้นักเรียนทาง LINE</p>
    </header>

    <form class="card" id="login" autocomplete="off">
      <label for="pw">รหัสผ่านครู</label>
      <div class="row">
        <input id="pw" type="password" required />
        <button type="submit">เข้าสู่ระบบ</button>
      </div>
      <label class="keep"><input type="checkbox" id="keep" checked /> จำรหัสผ่านในเครื่องนี้</label>
      <p class="msg" id="loginMsg" hidden></p>
    </form>

    <form class="card" id="paste" hidden>
      <label for="codes">วางรหัสจากนักเรียน (วางทั้งข้อความจาก LINE ได้เลย ใส่หลายคนพร้อมกันได้)</label>
      <textarea id="codes" rows="5" placeholder="SC1-..."></textarea>
      <div class="row">
        <button type="submit">ตรวจ</button>
        <button type="button" class="ghost" id="logout">ออกจากระบบ</button>
      </div>
      <p class="msg" id="pasteMsg" hidden></p>
    </form>

    <div id="out"></div>

    <section class="card" id="tools" hidden>
      <h2>ลิงก์ส่งนักเรียน</h2>
      <ul class="share">
        {share.map((it) => (
          <li>
            <a href={it.href}>{it.title}<small>{kinds[it.kind]} · {it.th}</small></a>
            <button type="button" class="ghost copy" data-url={`https://scitem.net${it.href}`}>คัดลอกลิงก์</button>
          </li>
        ))}
      </ul>
    </section>
  </section>
</Base>

<script>
  import { decodeCheck } from '../lib/check-code.js';
  import blob from '../data/check-keys.json';

  type Q = { label: string; kind: 'num' | 'mc'; answers?: string[]; answer?: number; solution: string };
  type Keys = Record<string, { title: string; questions: Q[] }>;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const STORE = 'scitem-teacher-pw';
  let keys: Keys | null = null;

  const b64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
  async function unlock(pw: string): Promise<Keys> {
    const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(pw), 'PBKDF2', false, ['deriveKey']);
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: b64(blob.salt), iterations: blob.iter, hash: 'SHA-256' },
      base, { name: 'AES-GCM', length: 256 }, false, ['decrypt'],
    );
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(blob.iv) }, key, b64(blob.ct));
    return JSON.parse(new TextDecoder().decode(plain));
  }

  // Reads what students type: "6 N", "20,000", "2x10^4", "0.5", "3/2", "2√10", "20π²", "√(3)". Returns NaN if it can't.
  function evalAns(raw: string): number {
    let s = raw.replace(/[,\s]/g, '').replace(/[−–]/g, '-').replace(/[×xX]/g, '*').replace(/\^2|²/g, '^2');
    s = (s.match(/^[0-9.+\-*/^()√π]+/)?.[0] ?? '').replace(/[+\-*/^(√]+$/, ''); // drop units like "N" or "m/s"
    let i = 0;
    const peek = () => s[i];
    const num = (): number => {
      const m = s.slice(i).match(/^\d*\.?\d+/);
      if (!m) return NaN;
      i += m[0].length;
      return Number(m[0]);
    };
    const primary = (): number => {
      const c = peek();
      if (c === 'π') { i++; return Math.PI; }
      if (c === '√') { i++; return Math.sqrt(power()); }
      if (c === '(') { i++; const v = expr(); if (peek() === ')') i++; return v; }
      return num();
    };
    const power = (): number => {
      const b = primary();
      if (peek() === '^') { i++; return b ** unary(); }
      return b;
    };
    const unary = (): number => (peek() === '-' ? (i++, -unary()) : power());
    const term = (): number => {
      let v = unary();
      for (;;) {
        const c = peek();
        if (c === '*') { i++; v *= unary(); }
        else if (c === '/') { i++; v /= unary(); }
        else if (c && /[\dπ√(.]/.test(c)) v *= power(); // 2√10, 20π², 2(3)
        else return v;
      }
    };
    const expr = (): number => {
      let v = term();
      while (peek() === '+' || peek() === '-') v = s[i++] === '+' ? v + term() : v - term();
      return v;
    };
    if (!s) return NaN;
    const v = expr();
    return i === s.length ? v : NaN;
  }
  // Equal within 0.5%, so 2√10 = √40 = 6.32 all count
  const same = (a: number, b: number) => Number.isFinite(a) && Number.isFinite(b) && Math.abs(a - b) <= 0.005 * Math.max(Math.abs(b), 1e-9);

  const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

  async function login(pw: string, quiet = false) {
    try {
      keys = await unlock(pw);
    } catch {
      if (!quiet) {
        $('loginMsg').textContent = 'รหัสผ่านไม่ถูกต้อง';
        $('loginMsg').hidden = false;
      }
      return;
    }
    try {
      if (($('keep') as HTMLInputElement).checked) localStorage.setItem(STORE, pw);
    } catch {}
    $('login').hidden = true;
    $('paste').hidden = false;
    $('tools').hidden = false;
  }

  type Row = { name: string; at: number; answers: string[]; secs: number[]; marks: boolean[] };

  function grade(q: Q, a: string) {
    if (q.kind === 'mc') return a !== '' && Number(a) === q.answer;
    const got = a.split('|');
    return q.answers!.every((ans, i) => same(evalAns(got[i] ?? ''), evalAns(ans)));
  }

  function shown(q: Q, a: string) {
    if (!a.replace(/\|/g, '')) return '—';
    return q.kind === 'mc' ? `ตัวเลือก ${'กขคง'[Number(a)] ?? a}` : a.split('|').join(', ');
  }

  function render(text: string) {
    const codes = [...new Set(text.match(/SC1-[A-Za-z0-9_-]+/g) ?? [])];
    const bad: string[] = [];
    const groups: Record<string, Row[]> = {};
    for (const c of codes) {
      const p = decodeCheck(c);
      if (!p || !keys![p[1]]) { bad.push(c.slice(0, 14) + '…'); continue; }
      const [, quiz, name, answers, secs, at] = p;
      const qs = keys![quiz].questions;
      (groups[quiz] ||= []).push({ name, at, answers, secs, marks: qs.map((q, i) => grade(q, answers[i] ?? '')) });
    }
    const msg = $('pasteMsg');
    msg.hidden = !(bad.length || !codes.length);
    msg.textContent = !codes.length ? 'ไม่พบรหัสในข้อความ (รหัสขึ้นต้นด้วย SC1-)' : `มี ${bad.length} รหัสที่อ่านไม่ได้ อาจคัดลอกมาไม่ครบ: ${bad.join(', ')}`;

    $('out').innerHTML = Object.entries(groups).map(([quiz, rows]) => {
      const { title, questions } = keys![quiz];
      rows.sort((a, b) => a.name.localeCompare(b.name, 'th'));
      const n = questions.length;
      const head = questions.map((q, i) => `<th title="${esc(q.label)}">${i + 1}<small>${esc(q.label)}</small></th>`).join('');
      const body = rows.map((r) => {
        const score = r.marks.filter(Boolean).length;
        const total = r.secs.reduce((a, b) => a + b, 0);
        const cells = questions.map((q, i) =>
          `<td class="${r.marks[i] ? 'ok' : 'no'}${r.secs[i] > 90 ? ' slow' : ''}">${r.marks[i] ? '✓' : '✗'}<small>${esc(shown(q, r.answers[i] ?? ''))}</small><small class="tm">${mmss(r.secs[i] ?? 0)}</small></td>`).join('');
        return `<tr><td class="nm"><b>${esc(r.name)}</b><small>${new Date(r.at * 60000).toLocaleString('th-TH', { dateStyle: 'short', timeStyle: 'short' })}</small></td><td><b>${score}/${n}</b><small>${mmss(total)}</small></td>${cells}</tr>`;
      }).join('');
      const pct = questions.map((_, i) => Math.round((100 * rows.filter((r) => r.marks[i]).length) / rows.length));
      const avg = questions.map((_, i) => Math.round(rows.reduce((a, r) => a + (r.secs[i] ?? 0), 0) / rows.length));
      const foot = `<tr><td colspan="2">ทำถูก</td>${pct.map((p) => `<td class="${p < 50 ? 'low' : ''}">${p}%</td>`).join('')}</tr>
        <tr><td colspan="2">เวลาเฉลี่ย</td>${avg.map((s) => `<td>${mmss(s)}</td>`).join('')}</tr>`;
      const sols = questions.map((q, i) => `<div class="sol"><p class="sh">ข้อ ${i + 1} · ${esc(q.label)}</p>${q.solution}</div>`).join('');
      return `<div class="card"><h2>${esc(title)} <span class="cnt">${rows.length} คน</span></h2>
        <div class="scroll"><table><thead><tr><th>ชื่อ</th><th>คะแนน</th>${head}</tr></thead><tbody>${body}</tbody><tfoot>${foot}</tfoot></table></div>
        <p class="hint">ช่องสีส้มเข้ม = ใช้เวลาเกิน 1 นาทีครึ่ง · ตัวเลขใต้เครื่องหมายคือคำตอบของนักเรียนและเวลาที่ใช้</p>
        <details><summary>เฉลยและวิธีทำ</summary>${sols}</details></div>`;
    }).join('');
  }

  $('login').addEventListener('submit', (e) => {
    e.preventDefault();
    login(($('pw') as HTMLInputElement).value);
  });
  $('paste').addEventListener('submit', (e) => {
    e.preventDefault();
    render(($('codes') as HTMLTextAreaElement).value);
  });
  $('logout').addEventListener('click', () => {
    try { localStorage.removeItem(STORE); } catch {}
    keys = null;
    $('out').innerHTML = '';
    $('paste').hidden = true;
    $('tools').hidden = true;
    $('login').hidden = false;
  });
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.url!);
        b.textContent = 'คัดลอกแล้ว';
      } catch {
        b.textContent = b.dataset.url!;
      }
      setTimeout(() => (b.textContent = 'คัดลอกลิงก์'), 2000);
    }),
  );
  let saved: string | null = null;
  try { saved = localStorage.getItem(STORE); } catch {}
  if (saved) login(saved, true);
</script>

<style>
  .t { max-width: 1000px; margin: 0 auto; padding: 0 20px 16px; }
  .head { padding: 40px 0 20px; }
  .head h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 0 0 6px; }
  .head p { margin: 0; color: var(--muted); }
  .card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); padding: 20px; margin: 0 0 18px; }
  #tools h2 { margin: 0 0 12px; font-size: 1.3rem; }
  .share { list-style: none; margin: 0; padding: 0; }
  .share li { display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: center; padding: 10px 0; border-top: 1px solid var(--border); }
  .share a { color: var(--ink); font-weight: 700; text-decoration: none; line-height: 1.35; }
  .share a small { display: block; color: var(--muted); font-weight: 400; }
  .share .copy { padding: 8px 14px; font-size: 0.9rem; }
  label { display: block; font-weight: 700; margin-bottom: 8px; }
  .keep { font-weight: 400; color: var(--muted); margin: 10px 0 0; display: flex; gap: 8px; align-items: center; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
  input[type='password'], textarea { flex: 1 1 200px; min-width: 0; width: 100%; font: inherit; font-size: 1rem; padding: 10px 12px; border: 2px solid var(--border); border-radius: 6px; background: var(--surface); }
  textarea { font-family: ui-monospace, Menlo, monospace; font-size: 0.85rem; }
  button { font: inherit; font-weight: 700; min-height: 44px; padding: 10px 22px; border: 2px solid var(--brand); border-radius: 999px; background: var(--brand); color: #fff; cursor: pointer; }
  .ghost { background: transparent; color: var(--brand); border: 2px solid var(--brand); }
  .msg { margin: 12px 0 0; font-weight: 700; color: #a6402a; }
  .hint { color: var(--muted); font-size: 0.85rem; margin: 10px 0; }
  #out :global(h2) { margin: 0 0 12px; font-size: 1.3rem; }
  #out :global(.cnt) { color: var(--muted); font-size: 0.95rem; font-weight: 400; }
  #out :global(.scroll) { overflow-x: auto; margin: 0 -8px; }
  #out :global(table) { border-collapse: collapse; font-size: 0.9rem; }
  #out :global(th), #out :global(td) { border-bottom: 1px solid var(--border); padding: 6px 8px; text-align: center; vertical-align: top; white-space: nowrap; }
  #out :global(th small) { display: block; font-weight: 400; color: var(--muted); font-size: 0.68rem; max-width: 6.5em; white-space: normal; line-height: 1.25; }
  #out :global(td small) { display: block; color: var(--muted); font-size: 0.72rem; font-weight: 400; }
  #out :global(td.nm), #out :global(th:first-child) { text-align: left; position: sticky; left: 0; background: var(--surface); }
  #out :global(td.ok) { background: #e7f8ef; }
  #out :global(td.no) { background: #fdecea; }
  #out :global(td.slow .tm) { color: #b45309; font-weight: 700; }
  #out :global(tfoot td) { font-weight: 700; }
  #out :global(tfoot td.low) { color: #a6402a; }
  #out :global(details) { margin-top: 8px; }
  #out :global(summary) { font-weight: 700; color: var(--brand); cursor: pointer; padding: 6px 0; }
  #out :global(.sol) { border-top: 1px solid var(--border); padding: 10px 0; }
  #out :global(.sol p) { margin: 2px 0; }
  #out :global(.sh) { font-weight: 700; }
  #out :global(.ans) { font-weight: 700; color: var(--brand); }
  #out :global(.flag) { color: #a6402a; font-size: 0.9rem; }
</style>
