---
import Base from '../layouts/Base.astro';
import { items, kinds } from '../data/catalog';
const share = items.filter((it) => it.href && it.kind !== 'tool');
---
<Base title="ครู · scitem" description="หน้าครู ดูผลเช็คพื้นฐาน" noindex>
  <section class="t">
    <header class="head">
      <h1>หน้าครู</h1>
      <p>ใส่รหัสผ่านเพื่อดูผลเช็คของนักเรียน และคัดลอกลิงก์ส่งให้นักเรียนทาง LINE</p>
    </header>

    <form class="card" id="login" autocomplete="off">
      <label for="pw">รหัสผ่านครู</label>
      <div class="row">
        <input id="pw" type="password" required />
        <button type="submit">เข้าสู่ระบบ</button>
      </div>
      <label class="keep"><input type="checkbox" id="keep" checked /> จำรหัสผ่านในเครื่องนี้</label>
      <p class="msg" id="loginMsg" hidden></p>
    </form>

    <section class="card" id="list" hidden>
      <div class="bar">
        <h2>ผลที่นักเรียนส่งมา</h2>
        <button type="button" class="ghost" id="reload">โหลดใหม่</button>
        <button type="button" class="ghost" id="logout">ออกจากระบบ</button>
      </div>
      <p class="msg" id="listMsg" hidden></p>
      <div id="rows"></div>
      <details class="paste">
        <summary>วางรหัส SC1- / LF1- (นักเรียนที่ส่งเข้าชีทไม่ได้)</summary>
        <textarea id="codes" rows="4" placeholder="SC1-..."></textarea>
        <div class="row"><button type="button" id="addCodes">เพิ่มในรายการ</button></div>
        <p class="msg" id="pasteMsg" hidden></p>
      </details>
    </section>

    <section class="card" id="detail" hidden></section>

    <section class="card" id="tools" hidden>
      <h2>ลิงก์ส่งนักเรียน</h2>
      <ul class="share">
        {share.map((it) => (
          <li>
            <a href={it.href}>{it.title}<small>{kinds[it.kind]} · {it.th}</small></a>
            <button type="button" class="ghost copy" data-url={`https://scitem.net${it.href}`}>คัดลอกลิงก์</button>
          </li>
        ))}
      </ul>
    </section>
  </section>
</Base>

<script>
  import { decodeCheck } from '../lib/check-code.js';
  import blob from '../data/check-keys.json';
  import mathBlob from '../data/math-keys.json';
  import { MATH_QUIZ, decodeLF, mathScore, mathReport, type MathKeys } from '../lib/math-level';
  import { checks, type Question } from '../data/checks';
  import { SHEET_URL, CLASS_SHEET_URL } from '../data/catalog';

  type Q = { label: string; kind: 'num' | 'mc'; answers?: string[]; answer?: number; solution: string };
  type Keys = Record<string, { title: string; questions: Q[] }>;

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const STORE = 'scitem-teacher-pw';
  let keys: Keys | null = null;
  let math: MathKeys | null = null;

  const b64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
  async function unlock(pw: string, b: typeof blob = blob): Promise<any> {
    const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(pw), 'PBKDF2', false, ['deriveKey']);
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt: b64(b.salt), iterations: b.iter, hash: 'SHA-256' },
      base, { name: 'AES-GCM', length: 256 }, false, ['decrypt'],
    );
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(b.iv) }, key, b64(b.ct));
    return JSON.parse(new TextDecoder().decode(plain));
  }

  // Reads what students type: "6 N", "20,000", "2x10^4", "0.5", "3/2", "2√10", "20π²", "√(3)". Returns NaN if it can't.
  function evalAns(raw: string): number {
    let s = raw.replace(/[,\s]/g, '').replace(/[−–]/g, '-').replace(/[×xX]/g, '*').replace(/\^2|²/g, '^2');
    s = (s.match(/^[0-9.+\-*/^()√π]+/)?.[0] ?? '').replace(/[+\-*/^(√]+$/, ''); // drop units like "N" or "m/s"
    let i = 0;
    const peek = () => s[i];
    const num = (): number => {
      const m = s.slice(i).match(/^\d*\.?\d+/);
      if (!m) return NaN;
      i += m[0].length;
      return Number(m[0]);
    };
    const primary = (): number => {
      const c = peek();
      if (c === 'π') { i++; return Math.PI; }
      if (c === '√') { i++; return Math.sqrt(power()); }
      if (c === '(') { i++; const v = expr(); if (peek() === ')') i++; return v; }
      return num();
    };
    const power = (): number => {
      const b = primary();
      if (peek() === '^') { i++; return b ** unary(); }
      return b;
    };
    const unary = (): number => (peek() === '-' ? (i++, -unary()) : power());
    const term = (): number => {
      let v = unary();
      for (;;) {
        const c = peek();
        if (c === '*') { i++; v *= unary(); }
        else if (c === '/') { i++; v /= unary(); }
        else if (c && /[\dπ√(.]/.test(c)) v *= power(); // 2√10, 20π², 2(3)
        else return v;
      }
    };
    const expr = (): number => {
      let v = term();
      while (peek() === '+' || peek() === '-') v = s[i++] === '+' ? v + term() : v - term();
      return v;
    };
    if (!s) return NaN;
    const v = expr();
    return i === s.length ? v : NaN;
  }
  // Equal within 0.5%, so 2√10 = √40 = 6.32 all count
  const same = (a: number, b: number) => Number.isFinite(a) && Number.isFinite(b) && Math.abs(a - b) <= 0.005 * Math.max(Math.abs(b), 1e-9);

  const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const mmss = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;

  let pw = '';
  async function login(pass: string, quiet = false) {
    try {
      keys = await unlock(pass);
    } catch {
      if (!quiet) {
        $('loginMsg').textContent = 'รหัสผ่านไม่ถูกต้อง';
        $('loginMsg').hidden = false;
      }
      return;
    }
    pw = pass;
    try { math = (await unlock(pass, mathBlob))[MATH_QUIZ]; } catch { math = null; } // a wrong key hides only the maths results
    try {
      if (($('keep') as HTMLInputElement).checked) localStorage.setItem(STORE, pass);
    } catch {}
    $('login').hidden = true;
    $('list').hidden = false;
    $('tools').hidden = false;
    load();
  }

  type Row = { quiz: string; name: string; at: number; answers: string[]; secs: number[]; code?: boolean };
  let sheetRows: Row[] = [];
  let codeRows: Row[] = [];
  let all: Row[] = [];

  async function load() {
    const msg = $('listMsg');
    if (!SHEET_URL) {
      msg.textContent = 'ยังไม่ได้ตั้งค่า Google Sheet (SHEET_URL ใน src/data/catalog.ts) ใช้ช่องวางรหัสด้านล่างไปก่อน';
      msg.hidden = false;
      return draw();
    }
    msg.textContent = 'กำลังโหลด…';
    msg.hidden = false;
    try {
      const r = await (await fetch(SHEET_URL, { method: 'POST', body: JSON.stringify({ action: 'list', pw }) })).json();
      if (!r.ok) throw new Error(r.error === 'pw' ? 'รหัสผ่านใน Apps Script ไม่ตรงกับรหัสผ่านครู' : 'โหลดไม่สำเร็จ');
      sheetRows = r.rows;
      msg.hidden = true;
    } catch (e) {
      msg.textContent = e instanceof Error && e.message.startsWith('รหัส') ? e.message : 'โหลดผลจาก Google Sheet ไม่สำเร็จ ลองกดโหลดใหม่';
    }
    draw();
  }

  function grade(q: Q, a: string) {
    if (q.kind === 'mc') return a !== '' && Number(a) === q.answer;
    const got = a.split('|');
    return q.answers!.every((ans, i) => same(evalAns(got[i] ?? ''), evalAns(ans)));
  }
  // Signs Check (public/signs-check/) is checked on the student's iPad and sends ready-made report lines
  const SIGNS_QUIZ = 'signs-1';
  const score = (r: Row) => keys![r.quiz].questions.filter((q, i) => grade(q, r.answers[i] ?? '')).length;
  const when = (ms: number) => new Date(ms).toLocaleString('th-TH', { dateStyle: 'medium', timeStyle: 'short' });

  // List: one group per quiz, newest first. Tap a row to open it.
  function draw() {
    all = [...sheetRows, ...codeRows].filter((r) => keys![r.quiz] || r.quiz === SIGNS_QUIZ || (r.quiz === MATH_QUIZ && !!math && decodeLF(r.answers.join('')))).sort((a, b) => b.at - a.at);
    const order = [...new Set([...Object.keys(checks), MATH_QUIZ, SIGNS_QUIZ, ...all.map((r) => r.quiz)])];
    const html = order.map((quiz) => {
      const rows = all.map((r, i) => [r, i] as const).filter(([r]) => r.quiz === quiz);
      if (!rows.length) return '';
      if (quiz === MATH_QUIZ) return `<h3>${esc(math!.title)} <span class="cnt">${rows.length} คน</span></h3><ul class="who">${rows.map(([r, i]) =>
        `<li><button type="button" data-i="${i}"><b>${esc(r.name)}</b><span>${when(r.at)}${r.code ? ' · จากรหัส' : ''}</span><em>${mathScore(decodeLF(r.answers.join(''))!)}</em></button></li>`).join('')}</ul>`;
      if (quiz === SIGNS_QUIZ) return `<h3>Signs Check − (−) <span class="cnt">${rows.length} ครั้ง</span></h3><ul class="who">${rows.map(([r, i]) =>
        `<li><button type="button" data-i="${i}"><b>${esc(r.name)}</b><span>${when(r.at)}</span><em>${esc((r.answers[1] ?? '').replace(/^Right first try (\d+\/\d+).*/, '$1'))}</em></button></li>`).join('')}</ul>`;
      const n = keys![quiz].questions.length;
      return `<h3>${esc(checks[quiz]?.title ?? keys![quiz].title)} <span class="cnt">${rows.length} คน</span></h3><ul class="who">${rows.map(([r, i]) =>
        `<li><button type="button" data-i="${i}"><b>${esc(r.name)}</b><span>${when(r.at)}${r.code ? ' · จากรหัส' : ''}</span><em>${score(r)}/${n}</em></button></li>`).join('')}</ul>`;
    }).join('');
    $('rows').innerHTML = html || '<p class="hint">ยังไม่มีใครส่ง</p>';
  }

  // Student answer or key, laid out like the question's boxes: "แนวราบ 8 N, แนวดิ่ง 6 N", "10√3"
  function fmt(m: Question | undefined, vals: string[], escape: boolean) {
    const v = (x: string) => (escape ? esc(x) : x);
    if (!m?.parts) return vals.map(v).join(', ');
    if (m.joiner) return vals.map(v).join(m.joiner);
    return m.parts.map((p, i) => [p.label, vals[i] ? `<b>${v(vals[i])}</b>` : '—', p.unit].filter(Boolean).join(' ')).join(', ');
  }

  function open(i: number) {
    const r = all[i];
    if (r.quiz === MATH_QUIZ) return show(`<button type="button" class="ghost" id="back">← กลับไปรายการ</button>${mathReport(decodeLF(r.answers.join(''))!, math!)}`);
    if (r.quiz === SIGNS_QUIZ) {
      show(`<button type="button" class="ghost" id="back">← กลับไปรายการ</button>
      <h2>${esc(r.name)}</h2><p class="hint">ส่งเมื่อ ${when(r.at)}</p><pre class="signs">${r.answers.map(esc).join('\n')}</pre>
      <h3>ที่ทด</h3><div id="ink"><p class="hint">กำลังโหลดที่ทด…</p></div>`);
      return void signsInk(r);
    }
    const { title, questions } = keys![r.quiz];
    const meta = checks[r.quiz]?.questions;
    const total = r.secs.reduce((a, b) => a + (b || 0), 0);
    const blocks = questions.map((q, k) => {
      const m = meta?.[k];
      const a = r.answers[k] ?? '';
      const ok = grade(q, a);
      const blank = !a.replace(/\|/g, '');
      let body = m ? `<p class="qt">${m.text}</p>` : '';
      if (q.kind === 'mc') {
        body += m?.options
          ? `<ul class="opts">${m.options.map((o, oi) => `<li class="${oi === q.answer ? 'right' : ''}${String(oi) === a ? ' picked' : ''}"><b>${'กขคง'[oi]}.</b> ${o}${String(oi) === a ? ' <em>← นักเรียนตอบ</em>' : ''}${oi === q.answer ? ' <em>✓ เฉลย</em>' : ''}</li>`).join('')}</ul>`
          : `<p>นักเรียนตอบ: ${blank ? '—' : 'กขคง'[Number(a)]} · เฉลย: ${'กขคง'[q.answer!]}</p>`;
        if (blank) body += '<p class="you">นักเรียนไม่ได้ตอบ</p>';
      } else {
        body += `<p class="you">นักเรียนตอบ: ${blank ? '—' : fmt(m, a.split('|'), true)}</p><p class="key">เฉลย: ${fmt(m, q.answers!, false)}</p>`;
      }
      return `<div class="qa ${ok ? 'ok' : 'no'}">
        <p class="qh"><span class="mk">${ok ? '✓' : '✗'}</span> ข้อ ${k + 1} · ${esc(q.label)} <small>${mmss(r.secs[k] ?? 0)}</small></p>
        ${body}<div class="sol"><p class="sh">วิธีทำ</p>${q.solution}</div></div>`;
    }).join('');
    show(`<button type="button" class="ghost" id="back">← กลับไปรายการ</button>
      <h2>${esc(r.name)} <span class="cnt">${score(r)}/${questions.length} · ${mmss(total)}</span></h2>
      <p class="hint">${esc(title)} · ส่งเมื่อ ${when(r.at)} · ข้อที่ใช้เวลาเกิน 1 นาทีครึ่งเวลาเป็นสีส้ม</p>${blocks}`);
    $('detail').querySelectorAll('.qa small').forEach((el, k) => (r.secs[k] ?? 0) > 90 && el.classList.add('slow'));
  }

  // Signs Check working space: one class-sheet row per question (id = "<run>-<question>"), strokes as flat x,y lists
  async function signsInk(r: Row) {
    const box = $('ink');
    const run = (r.answers.find((l) => l.startsWith('ink ')) ?? '').slice(4);
    if (!run || !CLASS_SHEET_URL) return void (box.innerHTML = '<p class="hint">ไม่มีที่ทด</p>');
    try {
      const j = await (await fetch(CLASS_SHEET_URL, { method: 'POST', body: JSON.stringify({ action: 'cget', cls: SIGNS_QUIZ, pw }) })).json();
      if (!j.ok) throw new Error();
      const order = (id: string) => { const k = id.slice(run.length + 1); return k === 'p' ? 0 : Number(k); };
      const rows = (j.rows as { id: string; data: string }[]).filter((x) => x.id.startsWith(run + '-')).sort((a, b) => order(a.id) - order(b.id));
      if (!rows.length) return void (box.innerHTML = '<p class="hint">น้องไม่ได้ใช้ที่ทด</p>');
      box.innerHTML = rows.map((x) => {
        const d = JSON.parse(x.data) as { q: string; w: number; h: number; s: number[][]; c: number };
        const k = order(x.id);
        const lines = d.s.map((st) => st.length === 2
          ? `<circle cx="${st[0]}" cy="${st[1]}" r="1.5" fill="#2b3a55"/>`
          : `<polyline points="${st.join(' ')}" fill="none" stroke="#2b3a55" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>`).join('');
        return `<div class="ink"><p class="qh">${k ? 'ข้อ ' + k : 'ข้อฝึก'} · ${esc(d.q)}${d.c ? ` <small>กดล้าง ${d.c} ครั้ง</small>` : ''}</p>
          <svg viewBox="0 0 ${d.w} ${d.h}" role="img" aria-label="ที่ทด">${lines}</svg></div>`;
      }).join('');
    } catch {
      box.innerHTML = '<p class="hint">โหลดที่ทดไม่สำเร็จ ลองเปิดใหม่</p>';
    }
  }

  function show(html: string) {
    $('detail').innerHTML = html;
    $('back').addEventListener('click', close);
    $('list').hidden = true;
    $('tools').hidden = true;
    $('detail').hidden = false;
    window.scrollTo(0, 0);
  }

  function close() {
    $('detail').hidden = true;
    $('list').hidden = false;
    $('tools').hidden = false;
  }

  $('rows').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-i]');
    if (b) open(Number(b.dataset.i));
  });
  $('reload').addEventListener('click', load);
  $('addCodes').addEventListener('click', () => {
    const text = ($('codes') as HTMLTextAreaElement).value;
    for (const c of new Set(text.replace(/\s+/g, '').match(/LF1-[A-Za-z0-9+/=]+/g) ?? [])) {
      const p = decodeLF(c);
      const at = p && Date.parse(p.ended || p.started);
      if (p && !codeRows.some((r) => r.quiz === MATH_QUIZ && r.at === at))
        codeRows.push({ quiz: MATH_QUIZ, name: p.name || 'No name', answers: [c], secs: [], at, code: true });
    }
    const codes = [...new Set(text.match(/SC1-[A-Za-z0-9_-]+/g) ?? [])];
    const bad: string[] = [];
    for (const c of codes) {
      const p = decodeCheck(c);
      if (!p || !keys![p[1]]) { bad.push(c.slice(0, 14) + '…'); continue; }
      const [, quiz, name, answers, secs, at] = p;
      if (!codeRows.some((r) => r.quiz === quiz && r.name === name && r.at === at * 60000))
        codeRows.push({ quiz, name, answers, secs, at: at * 60000, code: true });
    }
    const msg = $('pasteMsg');
    const lf = /LF1-/.test(text);
    msg.hidden = !(bad.length || (!codes.length && !lf));
    msg.textContent = !codes.length && !lf ? 'ไม่พบรหัสในข้อความ (รหัสขึ้นต้นด้วย SC1- หรือ LF1-)' : `มี ${bad.length} รหัสที่อ่านไม่ได้ อาจคัดลอกมาไม่ครบ: ${bad.join(', ')}`;
    ($('codes') as HTMLTextAreaElement).value = '';
    draw();
  });
  $('login').addEventListener('submit', (e) => {
    e.preventDefault();
    login(($('pw') as HTMLInputElement).value);
  });
  $('logout').addEventListener('click', () => {
    try { localStorage.removeItem(STORE); } catch {}
    keys = null;
    math = null;
    pw = '';
    sheetRows = [];
    codeRows = [];
    $('rows').innerHTML = '';
    $('detail').innerHTML = '';
    $('detail').hidden = true;
    $('list').hidden = true;
    $('tools').hidden = true;
    $('login').hidden = false;
  });
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.url!);
        b.textContent = 'คัดลอกแล้ว';
      } catch {
        b.textContent = b.dataset.url!;
      }
      setTimeout(() => (b.textContent = 'คัดลอกลิงก์'), 2000);
    }),
  );
  let saved: string | null = null;
  try { saved = localStorage.getItem(STORE); } catch {}
  if (saved) login(saved, true);
</script>

<style>
  .t { max-width: 1000px; margin: 0 auto; padding: 0 20px 16px; }
  .head { padding: 40px 0 20px; }
  .head h1 { font-size: clamp(2rem, 5vw, 2.8rem); margin: 0 0 6px; }
  .head p { margin: 0; color: var(--muted); }
  .card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); padding: 20px; margin: 0 0 18px; }
  #tools h2 { margin: 0 0 12px; font-size: 1.3rem; }
  .share { list-style: none; margin: 0; padding: 0; }
  .share li { display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: center; padding: 10px 0; border-top: 1px solid var(--border); }
  .share a { color: var(--ink); font-weight: 700; text-decoration: none; line-height: 1.35; }
  .share a small { display: block; color: var(--muted); font-weight: 400; }
  .share .copy { padding: 8px 14px; font-size: 0.9rem; }
  label { display: block; font-weight: 700; margin-bottom: 8px; }
  .keep { font-weight: 400; color: var(--muted); margin: 10px 0 0; display: flex; gap: 8px; align-items: center; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
  input[type='password'], textarea { flex: 1 1 200px; min-width: 0; width: 100%; font: inherit; font-size: 1rem; padding: 10px 12px; border: 2px solid var(--border); border-radius: 6px; background: var(--surface); }
  textarea { font-family: ui-monospace, Menlo, monospace; font-size: 0.85rem; }
  button { font: inherit; font-weight: 700; min-height: 44px; padding: 10px 22px; border: 2px solid var(--brand); border-radius: 999px; background: var(--brand); color: #fff; cursor: pointer; }
  .ghost { background: transparent; color: var(--brand); border: 2px solid var(--brand); }
  .msg { margin: 12px 0 0; font-weight: 700; color: #a6402a; }
  .hint { color: var(--muted); font-size: 0.85rem; margin: 10px 0; }
  .bar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  .bar h2 { margin: 0 auto 0 0; font-size: 1.3rem; }
  .bar button { padding: 6px 16px; min-height: 40px; font-size: 0.9rem; }
  .cnt { color: var(--muted); font-size: 0.95rem; font-weight: 400; }
  #rows :global(h3) { margin: 20px 0 6px; font-size: 1.1rem; }
  #rows :global(.who) { list-style: none; margin: 0; padding: 0; }
  #rows :global(.who button) {
    width: 100%; display: grid; grid-template-columns: 1fr auto; gap: 0 12px; text-align: left; align-items: center;
    background: transparent; color: var(--ink); border: 0; border-top: 1px solid var(--border); border-radius: 0; padding: 10px 4px; font-weight: 400;
  }
  #rows :global(.who button:hover) { background: var(--brand-soft); }
  #rows :global(.who span) { grid-column: 1; color: var(--muted); font-size: 0.88rem; }
