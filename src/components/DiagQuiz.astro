---
import { createHash } from 'node:crypto';

export interface Part {
  label?: string;
  unit?: string;
  answer: string;
}
export interface Question {
  text: string;
  /** 'num': one or more number boxes; 'mc': pick one option */
  kind: 'num' | 'mc';
  parts?: Part[];
  joiner?: string;
  options?: string[];
  answer?: number;
}
interface Props {
  id: string;
  title: string;
  subtitle: string;
  questions: Question[];
}
const { id, title, subtitle, questions } = Astro.props;

// Must match normNum() in the client script below.
function normNum(raw: string): string {
  const s = raw
    .replace(/[,\s]/g, '')
    .replace(/[−–]/g, '-')
    .replace(/[×xX*]10\^?\(?(-?\d+)\)?/, 'e$1');
  const m = s.match(/^-?\d*\.?\d+(e-?\d+)?/i);
  if (!m) return '';
  const n = Number(m[0]);
  return Number.isFinite(n) ? String(Number(n.toPrecision(10))) : '';
}
const hash = (qi: number, pi: number, norm: string) =>
  createHash('sha256').update(`scitem:${id}:${qi}:${pi}:${norm}`).digest('hex').slice(0, 24);

// Only hashes reach the browser, never the answers themselves.
const keys = questions.map((q, qi) =>
  q.kind === 'mc' ? [hash(qi, 0, String(q.answer))] : q.parts!.map((p, pi) => hash(qi, pi, normNum(p.answer))),
);
---
<section class="quiz" data-id={id} data-title={title}>
  <p class="eyebrow">ชุดวินิจฉัยก่อนเรียน</p>
  <h1>{title}</h1>
  <p class="lead">{subtitle}</p>

  <form class="card" id="start">
    <label for="name">ชื่อเล่น</label>
    <div class="row">
      <input id="name" class="name" maxlength="30" autocomplete="off" required />
      <button type="submit">เริ่มทำ</button>
    </div>
    <p class="hint">มี 5 ข้อ ข้อละประมาณ 1 นาที ตอบเป็นตัวเลขอย่างเดียวพอ ไม่ต้องแสดงวิธีทำ ไม่ใช้เครื่องคิดเลข ส่งแล้วแก้ไม่ได้</p>
  </form>

  <form id="qs" hidden>
    {questions.map((q, qi) => (
      <fieldset class="card q" data-kind={q.kind}>
        <legend><span class="num">D{qi + 1}</span></legend>
        <p class="qt" set:html={q.text} />
        {q.kind === 'num' ? (
          <div class="parts">
            {q.parts!.map((p, pi) => (
              <>
                {pi > 0 && q.joiner && <span class="joiner" set:html={q.joiner} />}
                <label class="part">
                  {p.label && <span class="plabel" set:html={p.label} />}
                  <input inputmode="decimal" autocomplete="off" aria-label={`D${qi + 1} ช่องที่ ${pi + 1}`} />
                  {p.unit && <span class="unit" set:html={p.unit} />}
                </label>
              </>
            ))}
          </div>
        ) : (
          <div class="opts">
            {q.options!.map((o, oi) => (
              <label class="opt"><input type="radio" name={`q${qi}`} value={oi} /> <span set:html={o} /></label>
            ))}
          </div>
        )}
      </fieldset>
    ))}
    <button type="submit" class="send">ส่งคำตอบ</button>
    <p class="msg" id="msg" role="alert" hidden></p>
  </form>

  <article class="card result" id="result" hidden>
    <h2 id="score"></h2>
    <p id="meta" class="hint"></p>
    <ul id="marks" class="marks"></ul>
    <p><b>ส่งผลให้ครู</b> กดปุ่มด้านล่างเพื่อส่งทาง LINE หรือคัดลอกข้อความไปวางในแชท</p>
    <pre id="report"></pre>
    <div class="row">
      <a class="btn line" id="line" target="_blank" rel="noopener">ส่งทาง LINE</a>
      <button type="button" id="copy" class="ghost">คัดลอกข้อความ</button>
    </div>
  </article>
</section>

<script is:inline define:vars={{ keys, id, title }}>
  function normNum(raw) {
    const s = raw
      .replace(/[,\s]/g, '')
      .replace(/[−–]/g, '-')
      .replace(/[×xX*]10\^?\(?(-?\d+)\)?/, 'e$1');
    const m = s.match(/^-?\d*\.?\d+(e-?\d+)?/i);
    if (!m) return '';
    const n = Number(m[0]);
    return Number.isFinite(n) ? String(Number(n.toPrecision(10))) : '';
  }
  async function hash(qi, pi, norm) {
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(`scitem:${id}:${qi}:${pi}:${norm}`));
    return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('').slice(0, 24);
  }

  const start = document.getElementById('start');
  const qs = document.getElementById('qs');
  const msg = document.getElementById('msg');
  let t0 = 0;
  let name = '';

  start.addEventListener('submit', (e) => {
    e.preventDefault();
    name = document.getElementById('name').value.trim();
    if (!name) return;
    start.hidden = true;
    qs.hidden = false;
    t0 = Date.now();
    qs.querySelector('input')?.focus();
  });

  qs.addEventListener('submit', async (e) => {
    e.preventDefault();
    const sets = [...qs.querySelectorAll('fieldset.q')];
    const blank = sets.some((f) =>
      f.dataset.kind === 'mc' ? !f.querySelector('input:checked') : [...f.querySelectorAll('input')].some((i) => !i.value.trim()),
    );
    if (blank && !msg.dataset.warned) {
      msg.textContent = 'ยังตอบไม่ครบ ถ้าจะส่งเลยให้กดส่งอีกครั้ง';
      msg.hidden = false;
      msg.dataset.warned = '1';
      return;
    }
    const secs = Math.round((Date.now() - t0) / 1000);
    const rows = [];
    let score = 0;
    for (let qi = 0; qi < sets.length; qi++) {
      const f = sets[qi];
      let ok = true;
      let shown;
      if (f.dataset.kind === 'mc') {
        const c = f.querySelector('input:checked');
        ok = !!c && (await hash(qi, 0, c.value)) === keys[qi][0];
        shown = c ? c.parentElement.textContent.trim() : '-';
      } else {
        const ins = [...f.querySelectorAll('input')];
        for (let pi = 0; pi < ins.length; pi++) {
          const n = normNum(ins[pi].value);
          if (!n || (await hash(qi, pi, n)) !== keys[qi][pi]) ok = false;
        }
        shown = ins.map((i) => i.value.trim() || '-').join(', ');
      }
      if (ok) score++;
      rows.push({ ok, shown });
    }
    qs.querySelectorAll('input, button').forEach((el) => (el.disabled = true));
    msg.hidden = true;

    const time = `${Math.floor(secs / 60)} นาที ${secs % 60} วินาที`;
    document.getElementById('score').textContent = `ได้ ${score} / ${rows.length}`;
    document.getElementById('meta').textContent = `${name} · ใช้เวลา ${time}`;
    document.getElementById('marks').innerHTML = rows
      .map((r, i) => `<li class="${r.ok ? 'ok' : 'no'}"><b>D${i + 1}</b> ${r.ok ? '✓' : '✗'} <span>ตอบ: ${r.shown.replace(/</g, '&lt;')}</span></li>`)
      .join('');
    const report = [
      `ผลชุดวินิจฉัย: ${title}`,
      `ชื่อ: ${name}`,
      `ได้ ${score}/${rows.length} · ใช้เวลา ${time}`,
      ...rows.map((r, i) => `D${i + 1} ${r.ok ? '✓' : '✗'} (ตอบ ${r.shown})`),
    ].join('\n');
    document.getElementById('report').textContent = report;
    document.getElementById('line').href = 'https://line.me/R/share?text=' + encodeURIComponent(report);
    document.getElementById('copy').onclick = async (ev) => {
      try {
        await navigator.clipboard.writeText(report);
        ev.target.textContent = 'คัดลอกแล้ว';
      } catch {
        ev.target.textContent = 'คัดลอกไม่ได้ ให้กดค้างที่ข้อความแทน';
      }
    };
    const res = document.getElementById('result');
    res.hidden = false;
    res.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  .quiz { max-width: 640px; margin: 0 auto; padding: 32px 0 16px; }
  .eyebrow { color: var(--brand); font-weight: 700; letter-spacing: 0.08em; margin: 0; }
  h1 { font-size: clamp(1.8rem, 6vw, 2.4rem); line-height: 1.2; margin: 4px 0 12px; }
  .lead { color: var(--muted); margin: 0 0 24px; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 20px; margin: 0 0 18px; }
  fieldset.card { min-width: 0; }
  legend { padding: 0 6px; }
  .num { background: var(--brand); color: #fff; font-weight: 700; border-radius: 8px; padding: 2px 10px; }
  .qt { margin: 0 0 12px; font-size: 1.08rem; }
  label { font-weight: 600; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
  input:not([type='radio']) {
    font: inherit; font-size: 1.1rem; padding: 10px 12px; border: 2px solid var(--border); border-radius: 10px;
    background: var(--bg); color: var(--text); min-width: 0;
  }
  input:focus { outline: none; border-color: var(--brand); }
  .name { flex: 1 1 200px; }
  .parts { display: flex; flex-wrap: wrap; gap: 10px 14px; align-items: center; }
  .part { display: flex; align-items: center; gap: 8px; }
  .part input { width: 7.5em; }
  .plabel, .unit, .joiner { color: var(--muted); font-weight: 600; }
  .joiner { font-size: 1.3rem; color: var(--text); }
  .opts { display: grid; gap: 8px; }
  .opt { display: flex; gap: 10px; align-items: flex-start; font-weight: 400; padding: 10px 12px; border: 1px solid var(--border); border-radius: 10px; cursor: pointer; }
  .opt:has(input:checked) { border-color: var(--brand); background: var(--brand-soft); }
  .opt input { margin-top: 0.45em; accent-color: var(--brand); }
  button, .btn {
    font: inherit; font-weight: 700; padding: 12px 22px; border: 0; border-radius: 999px;
    background: var(--brand); color: #fff; cursor: pointer; text-decoration: none; display: inline-block;
  }
  button:disabled { opacity: 0.5; cursor: default; }
  .send { width: 100%; }
  .ghost { background: transparent; color: var(--brand); border: 2px solid var(--brand); }
  .line { background: #06c755; }
  .hint { color: var(--muted); font-size: 0.92rem; margin: 10px 0 0; }
  .msg { margin: 12px 0 0; font-weight: 700; color: #a6402a; }
  .result h2 { margin: 0; font-size: 2rem; color: var(--brand); }
  .marks { list-style: none; padding: 0; margin: 14px 0; display: grid; gap: 6px; }
  .marks :global(li) { padding: 8px 12px; border-radius: 10px; }
  .marks :global(li.ok) { background: #e7f8ef; }
  .marks :global(li.no) { background: #fdecea; }
  .marks :global(span) { color: var(--muted); margin-left: 6px; }
  pre { white-space: pre-wrap; background: var(--bg); border: 1px dashed var(--border); border-radius: 10px; padding: 12px; font: inherit; font-size: 0.95rem; }
</style>
