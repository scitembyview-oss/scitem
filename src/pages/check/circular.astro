---
import Base from '../../layouts/Base.astro';
import DiagQuiz, { type Question } from '../../components/DiagQuiz.astro';

const questions: Question[] = [
  {
    text: 'แรง 10 N ทำมุม 37° กับแนวราบ จงแตกเป็นองค์ประกอบแนวราบและแนวดิ่ง',
    kind: 'num',
    parts: [
      { label: 'แนวราบ', unit: 'N', answer: '8' },
      { label: 'แนวดิ่ง', unit: 'N', answer: '6' },
    ],
  },
  {
    text: 'แรงลัพธ์ 10 N กระทำต่อมวล 2 kg ความเร่งเท่าใด',
    kind: 'num',
    parts: [{ unit: 'm/s²', answer: '5' }],
  },
  {
    text: 'ปล่อยลูกบอลจากที่สูง 5 m อัตราเร็วขณะถึงพื้นเท่าใด (ให้ g = 10 m/s²)',
    kind: 'num',
    parts: [{ unit: 'm/s', answer: '10' }],
  },
  {
    text: 'วัตถุเคลื่อนที่เป็นวงกลมด้วยอัตราเร็วคงตัว ข้อใดถูกต้อง',
    kind: 'mc',
    options: [
      'ไม่มีความเร่ง เพราะอัตราเร็วคงตัว',
      'มีความเร่ง เพราะทิศของความเร็วเปลี่ยนตลอดเวลา',
      'มีความเร่ง เพราะมีแรงหนีศูนย์กลางกระทำ',
      'ไม่มีความเร่ง เพราะแรงที่กระทำสมดุลกัน',
    ],
    answer: 1,
  },
  {
    text: 'จงทำ √300 ให้อยู่ในรูปอย่างง่าย a√b',
    kind: 'num',
    joiner: '√',
    parts: [{ answer: '10' }, { answer: '3' }],
  },
];
---
<Base title="ชุดวินิจฉัย: การเคลื่อนที่แบบวงกลม · scitem" description="แบบทดสอบก่อนเรียนเรื่องการเคลื่อนที่แบบวงกลม 5 ข้อ" noindex>
  <DiagQuiz id="circular-1" title="การเคลื่อนที่แบบวงกลม" subtitle="ทำก่อนคาบ เพื่อให้ครูรู้ว่าต้องทวนพื้นฐานตรงไหน ไม่มีผลกับคะแนน ตอบตามที่คิดได้เลย" questions={questions} />
</Base>
