---
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { families, numbered, LINE_URL, type Family } from '../data/catalog';

const keys = Object.entries(families) as [Family, (typeof families)[Family]][];
---
<Base
  title="scitem · ชีทวิทย์สองภาษา สำหรับเด็ก EP/Inter"
  description="ชีทวิทยาศาสตร์ไทย-อังกฤษ สำหรับนักเรียน EP และ International ป.5 ถึง ม.3 พร้อมคำแปลและคู่มือให้ผู้ปกครองช่วยทบทวนลูกได้"
>
  <section class="table" aria-label="ทุกบทเรียนของ scitem">
    <div class="key">
      <div class="intro">
        <h1>ชีทและบทเรียน<br />วิทย์สองภาษา</h1>
        <p>สำหรับเด็ก EP/Inter ป.5–ม.3 ทุกช่องในตารางคือบทเรียนหนึ่งเรื่อง แตะเพื่อเปิด</p>
        <a class="btn line" href={LINE_URL} target="_blank" rel="noopener">ขอชีทตัวอย่างฟรีทาง LINE</a>
      </div>
      <ul class="legend" aria-label="กลุ่มสี">
        {keys.map(([f, v]) => (
          <li>
            <a href={v.href} data-f={f} data-key={f}>
              <i aria-hidden="true"></i>
              <span><b>{v.th}</b> <span class="en">{v.en}</span><small>{v.blurb}</small></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    {numbered.map((it) => <Tile item={it} />)}
    <Tile ghost />
  </section>
</Base>

<style>
  .table {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-flow: row dense;
    gap: 10px;
    padding: 12px 0 0;
  }
  .key {
    grid-column: 2 / 6;
    grid-row: 1 / 3;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 20px 28px;
    align-items: center;
    padding: 4px 8px;
  }
  h1 { font-size: clamp(1.9rem, 3.6vw, 3rem); margin: 0 0 10px; letter-spacing: -0.02em; }
  .intro p { margin: 0 0 18px; color: var(--muted); max-width: 34ch; }
  .legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
  .legend a {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 8px 10px;
    min-height: 48px;
    border-radius: 6px;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.35;
    transition: background-color 0.2s;
  }
  .legend a:hover, .legend a:focus-visible { background: var(--surface); }
  .legend i { flex: none; width: 22px; height: 22px; margin-top: 1px; border: 2px solid var(--ink); border-radius: 4px; background: var(--f-fill); }
  .legend .en { color: var(--muted); font-size: 0.85rem; }
  .legend small { display: block; color: var(--muted); font-size: 0.82rem; }

  /* pointing at a family in the key lights up its tiles, like an interactive periodic table */
  .table:has([data-key='lessons']:is(:hover, :focus-visible)) :global(.tile:not([data-f='lessons'])),
  .table:has([data-key='students']:is(:hover, :focus-visible)) :global(.tile:not([data-f='students'])),
  .table:has([data-key='parents']:is(:hover, :focus-visible)) :global(.tile:not([data-f='parents'])),
  .table:has([data-key='teacher']:is(:hover, :focus-visible)) :global(.tile:not([data-f='teacher'])) {
    opacity: 0.18;
  }

  @media (max-width: 900px) {
    .key { grid-template-columns: 1fr; gap: 14px; }
    .legend small { display: none; }
  }
  @media (max-width: 700px) {
    .table { grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .key { grid-column: 1 / -1; grid-row: auto; padding: 8px 0 12px; }
    .legend { grid-template-columns: 1fr 1fr; }
    .legend small { display: block; }
    .table > :global(.ghost) { display: none; }
  }
  @media (max-width: 420px) {
    .legend { grid-template-columns: 1fr; }
  }
</style>
