---
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'scitem',
  url: 'https://scitem.net',
  description: 'ชีทวิทยาศาสตร์สองภาษา ไทย-อังกฤษ สำหรับนักเรียน EP และ International ป.5 ถึง ม.3',
  email: 'view@scitem.net',
  sameAs: ['https://lin.ee/NO52k1Y'],
});
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:site_name" content="scitem" />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={orgJsonLd} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="header-wrap">
    <header class="site-header">
      <a href="/" class="logo"><span class="logo-icon" aria-hidden="true">⚛</span><b>sci<span>tem</span></b></a>
      <nav>
        <a href="/#sheets">ชีท</a>
        <a href="/#class">ห้องเรียน</a>
        <a href="/#parents">สำหรับผู้ปกครอง</a>
        <a href="/vault/">เฉลย</a>
        <a href="/#contact">ติดต่อ</a>
      </nav>
    </header>
    </div>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-logo">sci<span>tem</span></p>
      <p>ชีทวิทย์สองภาษา สำหรับเด็ก EP/Inter · สอนโดยครูวิว</p>
      <p class="footer-links"><a href="https://lin.ee/NO52k1Y" target="_blank" rel="noopener">LINE</a> · <a href="mailto:view@scitem.net">view@scitem.net</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fffaf0;
    --surface: #ffffff;
    --text: #1e2a3a;
    --muted: #5b6878;
    --brand: #0d9488;
    --brand-dark: #0f766e;
    --brand-soft: #ccfbf1;
    --accent: #f59e0b;
    --pink: #ec4899;
    --violet: #7c3aed;
    --sky: #0ea5e9;
    --border: #eee4cf;
    --shadow: 0 2px 0 rgba(30, 42, 58, 0.06), 0 8px 24px rgba(30, 42, 58, 0.06);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background-color: var(--bg);
    background-image: radial-gradient(rgba(13, 148, 136, 0.12) 1.2px, transparent 1.2px);
    background-size: 22px 22px;
    color: var(--text);
    font-family: 'IBM Plex Sans Thai', system-ui, sans-serif;
    line-height: 1.7;
  }
  a { color: var(--brand-dark); }
  main { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  .header-wrap {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(255, 250, 240, 0.85);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .site-header {
    max-width: 1040px;
    margin: 0 auto;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.5rem;
    text-decoration: none;
    color: var(--text);
    letter-spacing: -0.02em;
  }
  .logo b span { color: var(--brand); }
  .logo .logo-icon {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--brand), var(--sky));
    color: #fff;
    font-size: 1.3rem;
    transform: rotate(-8deg);
    transition: transform 0.3s;
  }
  .logo:hover .logo-icon { transform: rotate(172deg); }
  nav { display: flex; gap: 4px; flex-wrap: wrap; }
  nav a {
    text-decoration: none;
    color: var(--muted);
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 999px;
    transition: background 0.2s, color 0.2s;
  }
  nav a:hover { color: var(--brand-dark); background: var(--brand-soft); }
  .site-footer {
    margin-top: 32px;
    text-align: center;
    color: #cbd5e1;
    font-size: 0.9rem;
    padding: 40px 16px;
    background: var(--text);
  }
  .site-footer p { margin: 4px 0; }
  .footer-logo { font-weight: 700; font-size: 1.4rem; color: #fff; }
  .footer-logo span { color: #5eead4; }
  .footer-links a { color: #5eead4; text-decoration: none; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
