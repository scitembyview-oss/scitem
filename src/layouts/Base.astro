---
import { LINE_URL } from '../data/catalog';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: 'scitem',
  url: 'https://scitem.net',
  description: 'ชีทวิทยาศาสตร์สองภาษา ไทย-อังกฤษ สำหรับนักเรียน EP และ International ป.5 ถึง ม.3',
  email: 'view@scitem.net',
  sameAs: [LINE_URL],
});
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  ['บทเรียน', '/lessons/'],
  ['MathTEM', '/mathtem/'],
  ['ตัวอย่างชีท', '/#sheets'],
  ['เกี่ยวกับครู', '/#teacher'],
  ['นักเรียน', '/students/'],
];
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://scitem.net/img/slides/light-5.jpg" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:site_name" content="scitem" />
    {noindex && <meta name="robots" content="noindex" />}
    <script type="application/ld+json" set:html={orgJsonLd} />
    <link rel="preload" href="/fonts/anuphan-thai.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="logo" aria-label="scitem หน้าแรก"><img src="/img/logo-bar.png" alt="scitem" width="190" height="48" /></a>
        <nav aria-label="เมนูหลัก">
          {nav.map(([label, href]) => (
            <a href={href} aria-current={href === path ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <a class="btn line small" href={LINE_URL} target="_blank" rel="noopener">ทักไลน์</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <a href="/" class="logo"><img src="/img/logo-bar-white.png" alt="scitem" width="190" height="48" loading="lazy" /></a>
          <p>วิทย์สองภาษา สำหรับเด็ก EP/Inter ป.5–ม.3 · สอนโดยครูวิว</p>
        </div>
        <p class="links">
          <a href={LINE_URL} target="_blank" rel="noopener">LINE scitem</a>
          <a href="mailto:view@scitem.net">view@scitem.net</a>
          <a href="/mathtem/">MathTEM ฝึกเลขพื้นฐาน</a>
          <a href="/teacher/">สำหรับครู</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Anuphan';
    font-weight: 100 700;
    font-display: swap;
    src: url(/fonts/anuphan-thai.woff2) format('woff2');
    unicode-range: U+02D7, U+0303, U+0331, U+0E01-0E5B, U+200C-200D, U+25CC;
  }
  @font-face {
    font-family: 'Anuphan';
    font-weight: 100 700;
    font-display: swap;
    src: url(/fonts/anuphan-latin.woff2) format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  :root {
    --paper: #ffffff;
    --tint: #f2f6fd;
    --grid: #e3eaf8;
    --ink: #14213d;
    --muted: #55607a;
    --blue: #2457d6;
    --blue-deep: #1b44ab;
    --marker: #ffe066;
    --line: #058a3d;
    --rule: #dbe2ee;
    --radius: 16px;
    /* old names, still used by the check, vault and teacher pages */
    --bg: var(--tint);
    --surface: var(--paper);
    --text: var(--ink);
    --border: var(--rule);
    --brand: var(--blue);
    --brand-soft: #e3ebfc;
    --accent: var(--marker);
    --ground: var(--tint);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; scroll-padding-top: 80px; }
  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: 'Anuphan', 'Noto Sans Thai', system-ui, sans-serif;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--marker); color: var(--ink); }
  a { color: var(--blue); text-underline-offset: 0.18em; text-decoration-thickness: 1.5px; }
  :focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  input, textarea { caret-color: var(--blue); accent-color: var(--blue); }
  h1, h2, h3 { line-height: 1.3; text-wrap: balance; letter-spacing: -0.01em; }
  img { max-width: 100%; display: block; }
  .wrap { max-width: 1160px; margin: 0 auto; padding: 0 20px; }
  main > :is(section, header, div):not(.full) { max-width: 1160px; margin-left: auto; margin-right: auto; padding-left: 20px; padding-right: 20px; }

  .site-header { position: sticky; top: 0; z-index: 10; background: rgb(255 255 255 / 0.92); backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--rule); }
  .bar { display: flex; align-items: center; gap: 12px 28px; min-height: 64px; }
  .logo { display: block; line-height: 0; }
  .logo img { height: 40px; width: auto; }
  .site-header nav { display: flex; gap: 4px; margin-left: auto; }
  .site-header nav a { padding: 8px 12px; border-radius: 10px; color: var(--ink); font-weight: 600; text-decoration: none; }
  .site-header nav a:hover { background: var(--tint); }
  .site-header nav a[aria-current='page'] { color: var(--blue); }
  @media (max-width: 760px) {
    .bar { flex-wrap: wrap; padding-top: 8px; }
    .site-header nav { order: 3; width: 100%; margin: 0 -12px; overflow-x: auto; }
    .site-header .btn { margin-left: auto; }
  }

  .site-footer { margin-top: 96px; padding: 36px 0 44px; background: var(--ink); color: #c9d2e6; font-size: 0.92rem; }
  .foot { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px 40px; flex-wrap: wrap; }
  .foot p { margin: 4px 0 0; }
  .foot .links { display: flex; gap: 8px 22px; flex-wrap: wrap; }
  .foot a:not(.logo) { color: #fff; font-weight: 600; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px;
    padding: 10px 24px; border: 0; border-radius: 999px;
    background: var(--blue); color: #fff; font: inherit; font-weight: 700; text-decoration: none; cursor: pointer;
    box-shadow: 0 6px 16px -8px rgb(36 87 214 / 0.7);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn.line { background: var(--line); color: #fff; box-shadow: 0 6px 16px -8px rgb(5 138 61 / 0.8); text-shadow: 0 1px 0 rgb(0 0 0 / 0.15); }
  .btn.ghost { background: transparent; color: var(--blue); box-shadow: inset 0 0 0 2px var(--blue); }
  .btn.small { min-height: 40px; padding: 6px 18px; font-size: 0.95rem; }
  .muted { color: var(--muted); }
  /* highlighter stroke behind a word */
  .mark { background: linear-gradient(transparent 58%, var(--marker) 58%, var(--marker) 92%, transparent 92%); padding: 0 0.1em; }
  ruby rt { font-size: 0.32em; font-weight: 600; color: var(--muted); letter-spacing: 0; }

  .page-head { padding: 48px 20px 28px; }
  .page-head h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0 0 8px; }
  .page-head p { margin: 0; color: var(--muted); max-width: 62ch; font-size: 1.08rem; }
</style>
