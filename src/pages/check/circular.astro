---
import Base from '../../layouts/Base.astro';
import BasicCheck from '../../components/BasicCheck.astro';
import { checks } from '../../data/checks';

// Questions: src/data/checks.ts · answer key + solutions: encrypted in src/data/check-keys.json under "circular-1".
const { title, questions } = checks['circular-1'];
---
<Base title="เช็คพื้นฐานก่อนเรียน: การเคลื่อนที่แบบวงกลม · scitem" description="เช็คพื้นฐานก่อนเรียนเรื่องการเคลื่อนที่แบบวงกลม 10 ข้อ" noindex>
